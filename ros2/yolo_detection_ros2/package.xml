<?xml version="1.0"?>
<package format="3">
  <name>yolo_detection_ros2</name>
  <version>0.1.0</version>
  <description>Publish YOLO mouse and cup detections as vision_msgs messages.</description>
  <maintainer email="student@example.com">Student</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
